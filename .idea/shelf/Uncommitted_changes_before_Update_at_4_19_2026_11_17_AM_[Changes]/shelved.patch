+    if char % 2 == 0:
+        even.append(char)
+print(even)
+print(sum(even))
+
+print("Filter Method")
+list1 = [20,3,60,3,5,3,6,13,88]
+even = list(filter(lambda x:x%2==0,list1))
+print(even)
